# =========================
# APP
# =========================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
PORT=3000
DRY_RUN=true

# =========================
# DATABASE / SUPABASE
# =========================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# =========================
# YOUTUBE
# =========================
YOUTUBE_API_KEY=[YOUR-YOUTUBE-DATA-API-KEY]
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=
YOUTUBE_DAILY_SEARCH_LIMIT=80
YOUTUBE_DAILY_GENERAL_LIMIT=9020
YOUTUBE_BATCH_SIZE=10
YOUTUBE_MAX_RESULTS_PER_SEARCH=15

# =========================
# GEMINI
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =========================
# TELEGRAM
# =========================
TELEGRAM_BOT_TOKEN=[YOUR-TELEGRAM-BOT-TOKEN]
TELEGRAM_CHAT_ID=[YOUR-TELEGRAM-CHAT-ID]

# =========================
# EMAIL VERIFICATION
# =========================
EMAIL_VERIFICATION_PROVIDER=local
EMAIL_VERIFICATION_API_KEY=

# =========================
# GMAIL / GOOGLE OAUTH
# =========================
GOOGLE_CLIENT_ID=[YOUR-GOOGLE-CLIENT-ID]
GOOGLE_CLIENT_SECRET=[YOUR-GOOGLE-CLIENT-SECRET]
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# =========================
# APPLICATION SECURITY
# =========================
SESSION_SECRET=change_me_to_a_secure_random_32_char_secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =========================
# WORKER
# =========================
WORKER_BATCH_SIZE=10
WORKER_MAX_RETRIES=3
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_TIMEOUT_MINUTES=30

# =========================
# CRON-JOB.ORG API
# =========================
CRON_JOB_API_KEY=[YOUR-CRON-JOB-ORG-API-KEY]

